{
  "name": "deepworks",
  "private": true,
  "description": "Deepworks — an idle optimization game in a layered underground mine, on the StarHermit engine.",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node tests/run.js && node --test tests/save.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "i18n": "node tools/i18n-sync.mjs",
    "serve": "node server.js"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
